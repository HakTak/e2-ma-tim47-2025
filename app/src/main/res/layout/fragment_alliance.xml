<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Header saveza -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#6200EE"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvAllianceDetailName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Naziv saveza"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>

        <TextView
            android:id="@+id/tvAllianceDetailLeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E0E0E0"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvAllianceMembers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E0E0E0"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- Naslov chata -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Razgovor saveza"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:padding="12dp"/>

    <!-- Poruke -->
    <TextView
        android:id="@+id/tvNoMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Još nema poruka. Budite prvi koji će pisati!"
        android:textColor="#888"
        android:gravity="center"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAllianceMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"/>

    <!-- Input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#F5F5F5"
        android:elevation="4dp">

        <EditText
            android:id="@+id/etAllianceMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Napiši poruku..."
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:background="@drawable/bg_message_input"
            android:padding="10dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnSendMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pošalji"
            android:layout_gravity="bottom"/>
    </LinearLayout>

</LinearLayout>