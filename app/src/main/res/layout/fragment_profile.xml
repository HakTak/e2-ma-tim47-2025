<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- AVATAR -->
        <ImageView
            android:id="@+id/ivProfileAvatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:layout_marginBottom="16dp"
            android:contentDescription="Avatar" />

        <!-- USERNAME -->
        <TextView
            android:id="@+id/tvProfileUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <!-- TITLE (Poboljšan prikaz) -->
        <TextView
            android:id="@+id/tvProfileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Početnik"
            android:textSize="18sp"
            android:textColor="@color/purple_primary"
            android:textStyle="bold|italic"
            android:layout_marginBottom="8dp" />

        <!-- LEVEL -->
        <TextView
            android:id="@+id/tvProfileLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nivo: 0"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="24dp" />

        <!-- STATS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/background_white"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Statistika"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProfilePP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PP (Snaga): 0"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvProfileXP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XP: 0 / 200"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/progressXP"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:max="200"
                android:progress="0"
                android:progressTint="@color/purple_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvProfileCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Novčići: 0"
                android:textSize="16sp"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- ===== NOVO: BEDŽEVI SEKCIJA ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/background_white"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/badges_label"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProfileBadges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Broj bedževa: 0"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bedževi dolaze uskoro..."
                android:textSize="14sp"
                android:textColor="@color/text_hint"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- ===== NOVO: OPREMA SEKCIJA ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/background_white"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equipment_label"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <!-- Dinamički se popunjava iz koda -->
            <LinearLayout
                android:id="@+id/layoutEquipmentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- DUGME ZA PROMENU LOZINKE -->
        <Button
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/change_password"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:backgroundTint="@color/purple_primary"
            android:layout_marginBottom="16dp" />

        <!-- QR CODE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_code"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp" />

        <ImageView
            android:id="@+id/ivQRCode"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@color/white"
            android:contentDescription="QR Code" />

    </LinearLayout>
</ScrollView>